{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VLCO Skill Run",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "run_id",
    "task_id",
    "skill",
    "version",
    "trigger",
    "phase",
    "selected_because",
    "alternatives_rejected",
    "expected_output",
    "actual_output",
    "checks_planned",
    "checks_run",
    "checks_not_run",
    "scores",
    "total_score",
    "result",
    "critical_failure",
    "retry_count",
    "evidence",
    "timestamp"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "skill": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "trigger": {
      "type": "string",
      "minLength": 1
    },
    "phase": {
      "type": "string",
      "minLength": 1
    },
    "selected_because": {
      "type": "string",
      "minLength": 1
    },
    "alternatives_rejected": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "expected_output": {
      "type": "string",
      "minLength": 1
    },
    "actual_output": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "checks_planned": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "checks_run": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "checks_not_run": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scores": {
      "type": "object",
      "required": [
        "trigger_accuracy",
        "procedure_adherence",
        "output_correctness",
        "validation_evidence",
        "efficiency",
        "clarity"
      ],
      "properties": {
        "trigger_accuracy": {
          "type": "number",
          "minimum": 0,
          "maximum": 15
        },
        "procedure_adherence": {
          "type": "number",
          "minimum": 0,
          "maximum": 20
        },
        "output_correctness": {
          "type": "number",
          "minimum": 0,
          "maximum": 30
        },
        "validation_evidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 20
        },
        "efficiency": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "clarity": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        }
      }
    },
    "total_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "result": {
      "enum": [
        "PASS",
        "PARTIAL",
        "FAIL",
        "NOT_NEEDED",
        "REDUNDANT"
      ]
    },
    "critical_failure": {
      "type": "boolean"
    },
    "retry_count": {
      "type": "integer",
      "minimum": 0
    },
    "duration_seconds": {
      "type": "number",
      "minimum": 0
    },
    "turns_used": {
      "type": "integer",
      "minimum": 0
    },
    "impact": {
      "type": "string"
    },
    "reviewer": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "timestamp": {
      "type": "string"
    }
  }
}
